{
  "name": "dolly_eval_gpt2_compatible_v1",
  "data_format": "Dolly plain-text prompt",
  "do_sample": false,
  "max_input_length": 768,
  "max_new_tokens": 256,
  "truncation_strategy": "middle_keep_head_and_tail",
  "stop_string": "\n\n###",
  "seed": 42,
  "primary_metric": "mean Rouge-L F1",
  "secondary_metric": "classification normalized exact-match accuracy",
  "test_policy": "Run test once after valid checkpoint selection is frozen"
}
